<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:id="@+id/title" android:text="Remote Target" android:textSize="26sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:text="Device ID" android:textSize="16sp" android:layout_marginTop="28dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/code" android:text="------" android:letterSpacing="0.18" android:textSize="38sp" android:textStyle="bold" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/status" android:text="Menghubungkan..." android:gravity="center" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/accessibility" android:text="Aktifkan Accessibility" android:layout_marginTop="28dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/share" android:text="Mulai Berbagi Layar" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/stop" android:text="Hentikan Sesi" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
