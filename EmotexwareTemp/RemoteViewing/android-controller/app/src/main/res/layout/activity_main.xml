<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#101114"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="EMOTEXWARE"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="Remote Support • v1.0.1"
        android:textSize="13sp"
        android:textColor="#B7BBC5"
        android:layout_marginTop="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginTop="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/code"
            android:hint="Model perangkat / identifier"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#8F949E"
            android:backgroundTint="#6E7CF7"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/connect"
            android:text="CONNECT"
            android:layout_marginStart="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:text="Masukkan model perangkat yang sudah terdaftar."
        android:textColor="#D9DCE3"
        android:padding="10dp"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <ImageView
        android:id="@+id/screen"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:background="#050608"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button android:id="@+id/back" android:text="Back" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" />
        <Button android:id="@+id/home" android:text="Home" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" />
        <Button android:id="@+id/recents" android:text="Recent" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" />
        <Button android:id="@+id/disconnect" android:text="Stop" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
